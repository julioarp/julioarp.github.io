  opRes[op] = idxs;
});

// Compact panel sizing: base 30px for 1 RE, +20px per additional RE
const opPanelH = {};
ops.forEach(op => {
  const n = Math.max(1, opRes[op].length);
  opPanelH[op] = 30 + (n-1)*20;  // 1 RE = 30, 2 REs = 50, 3 REs = 70
});

// Stack ops vertically with the new dynamic heights
const opGap = 14;
const totalOpsH = ops.reduce((sum, op) => sum + opPanelH[op], 0) + opGap*(ops.length-1);
const opsStart = padTop + (height - padTop - padBot - totalOpsH)/2;
