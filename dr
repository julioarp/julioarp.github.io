    if(!opOeMap[e.op]) opOeMap[e.op] = new Set();
    opOeMap[e.op].add(e.oeIdx);
  });
  Object.keys(opOeMap).forEach(op => {
    const sortedOes = [...opOeMap[op]].sort((a,b)=>a-b);
