  });
}

// Position of each circle: to the right of the panel, vertically distributed within the panel height
const yCircle = {};  // (op, oeIdx) -> y
ops.forEach(op => {
  const n = opRes[op].length;
  const panelTop = yOps[op] - opPanelH[op]/2;
  const panelBot = yOps[op] + opPanelH[op]/2;
  // Distribute n dots evenly within panel vertical extent, with margins
  if(n === 1){
    // Single dot centered with panel
    yCircle[op + "||" + opRes[op][0]] = yOps[op];
  } else {
    // Multiple dots: distribute from top to bottom of panel with small margins
    const topMargin = 8;
    const usable = opPanelH[op] - 2*topMargin;
    const step = usable / (n - 1);
    opRes[op].forEach((oeIdx, i) => {
      yCircle[op + "||" + oeIdx] = panelTop + topMargin + i*step;
    });
  }
});

