function yInBand(p, items, name){
  const band = pilarRows[p]*rowH;
  const total = items.length*rowH;
  const start = pilarTop[p] + (band-total)/2;
  const idx = items.indexOf(name);
  return start + idx*rowH + rowH/2;
}
