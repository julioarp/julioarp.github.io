  .tabs{display:flex;gap:4px;margin:18px 36px 0;border-bottom:2px solid var(--line);}
  .tab{padding:10px 22px;font-family:var(--font);font-size:13px;font-weight:600;color:var(--muted);cursor:pointer;border:2px solid transparent;border-bottom:none;border-radius:8px 8px 0 0;background:transparent;transition:all .15s;}
  .tab:hover{color:var(--ink);background:rgba(31,79,138,.05);}
  .tab.active{color:#1f4f8a;background:#ffffff;border-color:var(--line);border-bottom:2px solid #ffffff;margin-bottom:-2px;}
  .tab-content{display:none;}
  .tab-content.active{display:block;}

  /* Alignment table */
  .align-table-wrap{margin:16px 36px 30px;overflow-x:auto;}
  table.align-table{border-collapse:collapse;width:100%;font-family:var(--font);font-size:12px;background:#fff;}
  table.align-table th{background:#1f4f8a;color:#fff;font-weight:600;text-align:left;padding:10px 12px;border:1px solid #15375f;position:sticky;top:0;}
  table.align-table td{padding:9px 12px;border:1px solid var(--line);vertical-align:top;line-height:1.4;color:var(--ink);}
  table.align-table tr:nth-child(even) td{background:#f7fafd;}
  .badge{display:inline-block;padding:3px 9px;border-radius:10px;font-size:11px;font-weight:700;white-space:nowrap;}
  .badge.strong{background:#c6efce;color:#1d6233;}
  .badge.weak{background:#ffeb9c;color:#7a5d10;}
  .badge.none{background:#f2f2f2;color:#888;}
  .col-op{font-weight:700;white-space:nowrap;}
  .col-num{text-align:center;font-weight:600;}
</style>
