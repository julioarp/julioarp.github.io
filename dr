const colorScale = d3.scaleLinear()
  .domain([1.0, 1.5, 2.0, 2.4, 3.0])
  .range(["#e89b6e","#eda874","#f2c14e","#b6c84a","#3fb96b"])
  .interpolate(d3.interpolateRgb).clamp(true);
function gradColor(a){if(a===null)return "#c8cfdc"; return colorScale(a);}
function avgLabel(a){if(a===null)return "sin operación vinculada"; return "prom. "+a.toFixed(2);}

const pilarOrder=["P1","P2","P3"];
const ersOrdered=[];
pilarOrder.forEach(p=>Object.keys(ER).forEach(er=>{if(ER[er].p===p&&!ersOrdered.includes(er))ersOrdered.push(er);}));
const objsOrdered=[];
pilarOrder.forEach(p=>ersOrdered.forEach(er=>{if(ER[er].p===p){const o=ER[er].obj;if(!objsOrdered.find(x=>x.name===o))objsOrdered.push({name:o,p:p});}}));
const ops=[];
pilarOrder.forEach(p=>ersOrdered.forEach(er=>{if(ER[er].p===p){EDGES.filter(e=>e.re===er).map(e=>e.op).forEach(op=>{if(!ops.includes(op))ops.push(op);});}}));

function savg(rows){const u=[...new Set(rows)].filter(op=>V[PROB[op]]!==undefined); if(!u.length)return null;return u.reduce((a,b)=>a+V[PROB[b]],0)/u.length;}
const erAvg={};ersOrdered.forEach(er=>{erAvg[er]=savg(EDGES.filter(e=>e.re===er).map(e=>e.op));});
const objAvg={};objsOrdered.forEach(o=>{objAvg[o.name]=savg(EDGES.filter(e=>ER[e.re].obj===o.name).map(e=>e.op));});

const reAlign={};
ersOrdered.forEach(er=>{
  const rows=EDGES.filter(e=>e.re===er);
  if(!rows.length){reAlign[er]="sin cobertura";return;}
  // Per RE: one alignment per unique operation (any Strong => count as Strong for that op)
  const opAlignMap = {};
  rows.forEach(e=>{
    if(opAlignMap[e.op]==="Strong") return;
    opAlignMap[e.op] = e.align;
  });
  const opList = Object.values(opAlignMap);
  const strongPct = opList.filter(a=>a==="Strong").length / opList.length;
  reAlign[er] = strongPct>=0.51 ? "Fuerte" : "Débil";
});

// Stats: total vínculos counts unique op-RE pairs (not OE-RE edges)
const uniqueOpReEdges = [...new Set(EDGES.map(e=>e.op+"|"+e.re))];
const uniqueOpReStrong = uniqueOpReEdges.filter(k=>EDGES.find(e=>(e.op+"|"+e.re)===k && e.align==="Strong"));
const uniqueOpReWeak = uniqueOpReEdges.filter(k=>!EDGES.find(e=>(e.op+"|"+e.re)===k && e.align==="Strong"));
const stats=[
  [objsOrdered.length,"Objetivos Estratégicos de la EBP"],
  [ersOrdered.length,"Resultados Esperados"],
  [ops.length,"Operaciones"],
  [uniqueOpReEdges.length,"Vínculos operación-RE"],
  [uniqueOpReStrong.length,"Vínculos fuertes"],
  [uniqueOpReWeak.length,"Vínculos débiles"]
];
const sd=d3.select("#stats");
stats.forEach(s=>{const d=sd.append("div").attr("class","stat");d.append("div").attr("class","n").text(s[0]);d.append("div").attr("class","l").text(s[1]);});

// ---------- INSIGHT PANEL ----------
// 1) % of Expected Results (RE) covered by SG portfolio
const reCovered = ersOrdered.filter(er => reAlign[er] !== "sin cobertura").length;
const reTotal = ersOrdered.length;
const pctCovered = Math.round(100*reCovered/reTotal);
// (also keep OE coverage for the strong-alignment card)
const oeCovered = objsOrdered.filter(o => objAvg[o.name] !== null).length;
const oeTotal = objsOrdered.length;

// 2) % of covered REs with strong alignment (RE-level rule).
const reStrong = ersOrdered.filter(er => reAlign[er] === "Fuerte").length;
const pctStrong = reCovered ? Math.round(100*reStrong/reCovered) : 0;

// 3) Aggregate probability — simple average across covered OEs
const covAvgs = objsOrdered.filter(o=>objAvg[o.name]!==null).map(o=>objAvg[o.name]);
const aggProb = covAvgs.length ? covAvgs.reduce((a,b)=>a+b,0)/covAvgs.length : null;
function probBand(v){if(v===null)return ["red","Sin datos"]; if(v>=2.4) return ["green","Alta"]; if(v>1.5) return ["amber","Media"]; return ["red","Baja"];}
const [aggClass, aggLabel] = probBand(aggProb);

const coverageClass = pctCovered>=80 ? "green" : (pctCovered>=60 ? "amber" : "red");
const strongClass   = pctStrong>=80 ? "green" : (pctStrong>=60 ? "amber" : "red");

const cards = [
  {cls:coverageClass, lbl:"Cobertura de la cartera", val:pctCovered+"<span class='small'>%</span>", desc:`${reCovered} de ${reTotal} resultados esperados de la EBP cubiertos por operaciones con garantía soberana.`},
  {cls:strongClass, lbl:"Alineación fuerte", val:pctStrong+"<span class='small'>%</span>", desc:`${reStrong} de ${reCovered} resultados esperados con cobertura califican como alineación fuerte.`},
  {cls:aggClass, lbl:"Probabilidad agregada de lograr resultados", val:(aggProb!==null?aggProb.toFixed(2):"—")+`<span class='small'> / 3 · ${aggLabel}</span>`, desc:`Promedio simple de probabilidad de logro de los objetivos cubiertos según la última revisión de cartera.`}
];
const ip = d3.select("#insight");
cards.forEach(c=>{
  const d = ip.append("div").attr("class","card "+c.cls);
  d.append("div").attr("class","bar");
  d.append("div").attr("class","lbl").text(c.lbl);
  d.append("div").attr("class","val").html(c.val);
  d.append("div").attr("class","desc").text(c.desc);
});

// Callout: highlight the two specific risk areas
const oeAmber = objsOrdered.filter(o=>objAvg[o.name]!==null && objAvg[o.name]<2.4).map(o=>o.name);
const oeUncovered = objsOrdered.filter(o=>objAvg[o.name]===null).map(o=>o.name);
// Helper: join an array in natural Spanish ("A y B" / "A, B y C")
function listJoin(arr){
  if(!arr.length) return "";
  if(arr.length===1) return arr[0];
  if(arr.length===2) return arr[0]+" y "+arr[1];
  return arr.slice(0,-1).join(", ")+" y "+arr[arr.length-1];
}

