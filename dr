function drawNode(x,y,w,label,fill,meta){
  const g=svg.append("g");
  // Try fitting on one line at font size 12; if too wide, wrap to two lines.
  const measureSvg = svg;
  const tmp = measureSvg.append("text").attr("class","node-label").attr("font-size","12px").style("visibility","hidden").text(label);
  const oneLineWidth = tmp.node().getComputedTextLength();
  tmp.remove();

  const padding = 16;
  const useTwoLines = oneLineWidth > (w - padding);
  let lines = [label];
  let fontSize = 12;

  if(useTwoLines){
    // Split label into two roughly balanced lines on word boundary.
    const words = label.split(" ");
    if(words.length >= 2){
      // Try every split point and pick the one that minimizes the max line width.
      let best = null;
      for(let i=1; i<words.length; i++){
        const l1 = words.slice(0,i).join(" ");
        const l2 = words.slice(i).join(" ");
        const t1 = measureSvg.append("text").attr("class","node-label").attr("font-size","12px").style("visibility","hidden").text(l1);
        const t2 = measureSvg.append("text").attr("class","node-label").attr("font-size","12px").style("visibility","hidden").text(l2);
        const m = Math.max(t1.node().getComputedTextLength(), t2.node().getComputedTextLength());
        t1.remove(); t2.remove();
        if(best===null || m < best.m){ best = {l1, l2, m}; }
      }
      lines = [best.l1, best.l2];
      // If even the best two-line split is too wide, shrink font down to 10.
      if(best.m > w - padding){
        while(best.m > w - padding && fontSize > 10){
          fontSize -= 0.5;
          const t1 = measureSvg.append("text").attr("class","node-label").attr("font-size",fontSize+"px").style("visibility","hidden").text(best.l1);
          const t2 = measureSvg.append("text").attr("class","node-label").attr("font-size",fontSize+"px").style("visibility","hidden").text(best.l2);
          best.m = Math.max(t1.node().getComputedTextLength(), t2.node().getComputedTextLength());
          t1.remove(); t2.remove();
        }
      }
    }
  }

  // Box height grows when we have two lines.
  const lineHeight = fontSize + 3;
  const h = (lines.length===1) ? 26 : (lineHeight*lines.length + 12);

  g.append("rect").attr("class","node-rect").attr("x",x-w/2).attr("y",y-h/2).attr("width",w).attr("height",h).attr("rx",6).attr("fill",fill).attr("opacity",0.95).attr("stroke","#ffffff").attr("stroke-width",0.5);

  const c=d3.color(fill); const lum=c?(0.299*c.r+0.587*c.g+0.114*c.b):255;
  const textFill = (lum>140) ? "#1a2238" : "#ffffff";

  const textEl = g.append("text").attr("class","node-label").attr("x",x).attr("text-anchor","middle").attr("fill",textFill).attr("font-size",fontSize+"px");
  if(lines.length===1){
    textEl.attr("y", y+4).text(lines[0]);
  } else {
    // vertical centering: first tspan above center, second below
    const topY = y - (lineHeight*(lines.length-1))/2 + 4;
    lines.forEach((ln,i)=>{
      textEl.append("tspan").attr("x",x).attr("y", topY + i*lineHeight).text(ln);
    });
  }

  g.style("cursor","pointer")
    .on("mouseover",ev=>{highlight(meta);if(meta.full)showTip(meta.full,ev);})
    .on("mousemove",ev=>{if(meta.full)showTip(tip.html(),ev);})
    .on("mouseout",()=>{unhighlight();hideTip();});
  return g;
}

