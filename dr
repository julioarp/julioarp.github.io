  .insight{margin:18px 36px 6px;display:grid;grid-template-columns:repeat(3,1fr);gap:14px;font-family:var(--font);}
  .insight .card{background:#ffffff;border:1px solid var(--line);border-radius:10px;padding:14px 16px;position:relative;overflow:hidden;}
  .insight .card .bar{position:absolute;left:0;top:0;bottom:0;width:5px;}
  .insight .card.green .bar{background:var(--alta);}
  .insight .card.amber .bar{background:var(--media);}
  .insight .card.red .bar{background:var(--baja);}
  .insight .lbl{font-size:11px;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);font-weight:600;margin-bottom:6px;}
  .insight .val{font-size:32px;font-weight:700;line-height:1.1;color:var(--ink);}
  .insight .val .small{font-size:16px;font-weight:500;color:var(--muted);margin-left:4px;}
  .insight .desc{font-size:11px;color:var(--muted);margin-top:6px;line-height:1.45;}

  .callout{margin:8px 36px 14px;background:#fff7e6;border-left:4px solid var(--media);border-radius:6px;padding:12px 16px;font-family:var(--font);font-size:12px;color:#5b4a1a;line-height:1.55;}
