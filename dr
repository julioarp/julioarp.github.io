function renderAlignTable(){
  const wrap = document.getElementById('align-table-wrap');
  let html = '<table class="align-table"><thead><tr>' +
    '<th>Operación</th>' +
    '<th>RE op. #</th>' +
    '<th>Resultado Esperado de la operación</th>' +
    '<th>Resultado Esperado de la EBP</th>' +
    '<th>Alineación</th>' +
    '<th>Justificación del razonamiento</th>' +
    '</tr></thead><tbody>';
  // Consecutive RE numbering per operation (only for rows with a connection)
  const reNum = {};
  const counters = {};
  OE_TABLE.forEach(r=>{
    if(r.re && r.re !== '(sin conexión lógica)'){
      if(!(r.op in counters)) counters[r.op] = 0;
    }
  });
  // Build per (op,idx) consecutive number among connected ones
  const seen = {};
  OE_TABLE.forEach(r=>{
    const connected = r.re && r.re !== '(sin conexión lógica)';
    const key = r.op + '|' + r.idx;
    if(connected && !(key in seen)){
      if(!(r.op in counters)) counters[r.op]=0;
      counters[r.op]++;
      seen[key] = counters[r.op];
    }
  });
  OE_TABLE.forEach(r=>{
    const connected = r.re && r.re !== '(sin conexión lógica)';
    const key = r.op + '|' + r.idx;
    let badge, reNumLabel;
    if(r.align === 'Strong'){ badge = '<span class="badge strong">Fuerte</span>'; }
    else if(r.align === 'Weak'){ badge = '<span class="badge weak">Débil</span>'; }
    else { badge = '<span class="badge none">Sin conexión</span>'; }
    reNumLabel = connected ? ('RE' + seen[key]) : '—';
    const reText = connected ? r.re : '<span style="color:#aaa;font-style:italic">(sin conexión lógica)</span>';
    html += '<tr>' +
      '<td class="col-op">' + r.op + '</td>' +
      '<td class="col-num">' + reNumLabel + '</td>' +
      '<td>' + r.oe + '</td>' +
      '<td>' + reText + '</td>' +
      '<td>' + badge + '</td>' +
      '<td>' + r.rationale + '</td>' +
      '</tr>';
  });
  html += '</tbody></table>';
  wrap.innerHTML = html;
}
renderAlignTable();

function switchTab(name){
  document.querySelectorAll('.tab').forEach(t=>{
    t.classList.toggle('active', t.dataset.tab===name);
  });
  document.querySelectorAll('.tab-content').forEach(c=>{
    c.classList.toggle('active', c.id === 'tab-'+name);
  });
}

